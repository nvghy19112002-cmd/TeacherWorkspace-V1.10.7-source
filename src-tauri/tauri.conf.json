{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Teacher Workspace",
  "version": "2.0.1",
  "identifier": "com.teacherworkspace.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Teacher Workspace",
        "width": 1440,
        "height": 940,
        "minWidth": 1024,
        "minHeight": 700,
        "backgroundColor": "#f6f8f7"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost 'self' https://generativelanguage.googleapis.com; frame-src 'self' blob:; object-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Offline teaching schedule and personal workspace",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVEOEVEMEEwNjcwNjFBREYKUldUZkdnWm5vTkNPN2RhOUQ0RnJPajVCQWdsMUVWb1R5SGpINjBYTStmVGdFbUlmbkJGY2lNOWUK",
      "endpoints": [
        "https://github.com/nvghy19112002-cmd/TeacherWorkspace-V1.10.7-source/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
